# PostgreSQL из docker-compose.yml
DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_tracker?schema=public"
PORT=3001
# Origin фронтенда для CORS
WEB_ORIGIN=http://localhost:3000
# Секрет подписи JWT, минимум 32 символа. Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Срок жизни access-токена (формат ms: 15m, 1d, 7d)
JWT_EXPIRES_IN=1d
# development | production | test; в production Swagger UI (/api/docs) выключен
NODE_ENV=development
